<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:mRemoteNG.Avalonia.Localization"
        xmlns:mi="using:Material.Icons.Avalonia"
        xmlns:dlg="using:mRemoteNG.Avalonia.Views.Dialogs"
        x:Class="mRemoteNG.Avalonia.Views.Dialogs.LegacyImportDialog"
        Classes="dialog"
        Title="{l:Tr LegacyImportTitle}"
        Width="560"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="NotNowButton" Content="{l:Tr LegacyImportNotNow}" MinWidth="88" IsCancel="True"/>
                <Button x:Name="OpenButton" Content="{l:Tr LegacyImportOpen}" MinWidth="88"/>
                <Button x:Name="ImportButton" Content="{l:Tr LegacyImportImport}" Classes="accent" MinWidth="88" IsDefault="True"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="24,20,24,24" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                <mi:MaterialIcon Kind="Import" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Classes="h2" Text="{l:Tr LegacyImportTitle}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Classes="caption" Text="{l:Tr LegacyImportIntro}" TextWrapping="Wrap"/>
            <ListBox x:Name="FileList" MaxHeight="260" MinHeight="72">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="dlg:LegacyFileItem">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Classes="caption" Text="{Binding Details}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </DockPanel>
</Window>
